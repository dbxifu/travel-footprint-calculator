# In here we exclude files from the docker context when building our image.
# It's easier to do this and use "ADD . ." instead of allowlisting in COPY.

# Our various databases (they'll be volumes, we don't want them in the image)
# They used to be at the root, now they are in var/db ; I still have some files dangling so this stays
/database*.db
/database*.db.*
/geocache.db
/geocache.db.*

# Our runtime files
/var/*

# Local dev virtualenv
/venv*

# Docker
/docker/*
/Dockerfile
/docker-compose.yml
/docker-compose.*.yml
/compose.yml
/compose.*.yml

# OS
.directory

# IDE
.idea
